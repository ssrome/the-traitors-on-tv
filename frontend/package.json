{
  "name": "The Traitors On TV",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ENV=development node -r dotenv/config mynode.js && ng serve -c development",
    "start": "node -r dotenv/config mynode.js && ng serve",
    "build": "node -r dotenv/config mynode.js && ng build",
    "build:local": "node -r dotenv/config mynode.js && ng build -c development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --browsers=ChromeHeadless --watch",
    "test:headless": "ng test --watch=false --browsers=ChromeHeadless",
    "serve:ssr:app": "node dist/app/server/server.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.5",
    "algoliasearch": "^5.61.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~7.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~6.0.3"
  }
}
